{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desk",
  "version": "0.4.0",
  "identifier": "io.github.traoreera.desk",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev:desktop",
    "beforeBuildCommand": "pnpm build:desktop"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Desk", "width": 1280, "height": 800, "minWidth": 380, "minHeight": 500 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://127.0.0.1:* http://localhost:*; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["erp"] } }
  }
}
