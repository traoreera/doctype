{
  "name": "xcore-doctype-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desk de xcore-doctype : interface Vue 3 + PrimeVue, servie par le plugin (build dans ../src/xcore_doctype/ui/dist).",
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/desk.e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@primeuix/themes": "^2.0.3",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "pinia": "^4.1.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.3",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
